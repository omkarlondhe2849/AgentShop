# === AI Provider (choose one) ===

# Option A: OpenAI API Key
OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com   (default, no need to set)
# AI_MODEL=gpt-4o-mini                     (default)

# Option B: Google Gemini via OpenAI-compatible endpoint
# OPENAI_API_KEY=your-google-ai-studio-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.0-flash

# === Razorpay Test Mode ===
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
